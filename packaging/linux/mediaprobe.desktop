[Desktop Entry]
Type=Application
Name=MediaProbe
Comment=Standalone media file inspector
Exec=mediaprobe %f
Icon=mediaprobe
Terminal=false
Categories=AudioVideo;Utility;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;audio/mpeg;audio/flac;audio/wav;audio/ogg;audio/aac;image/png;image/jpeg;image/webp;image/gif;
StartupNotify=true
